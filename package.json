{
  "name": "backend-m_wa-education-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for an online examination system (teachers + students) — Express, Prisma, PostgreSQL",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "reset": "prisma migrate reset --force",
    "test:realtime": "node scripts/realtime-smoke.mjs",
    "test:db": "node scripts/test-db.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"prisma/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"prisma/**/*.js\" \"*.js\"",
    "test:unit": "node --import ./tests/setup-env.js --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --import ./tests/setup-env.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test": "node --import ./tests/setup-env.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "node --import ./tests/setup-env.js --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.js\"",
    "test:ci": "node scripts/ci-test.mjs",
    "test:api": "playwright test",
    "test:api:report": "playwright test --reporter=html"
  },
  "keywords": [
    "exam",
    "education",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4"
  }
}
