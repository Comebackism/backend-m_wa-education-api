# ---------------------------------------------------------------------------
# copy this file to `.env` and fill in real values
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# local:  postgresql://postgres:postgres@localhost:5432/wa_education?schema=public
# docker: postgresql://postgres:postgres@localhost:5433/wa_education?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_education?schema=public"

# JWT — use long random strings in production (openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_ROUNDS=10

# comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
