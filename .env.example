# ---------------------------------------------------------------------------
# copy this file to `.env` and fill in real values
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# local:  postgresql://postgres:postgres@localhost:5432/wa_education?schema=public
# docker: postgresql://postgres:postgres@localhost:5433/wa_education?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_education?schema=public"

# JWT — use long random strings in production (openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_ROUNDS=10

# comma separated list of allowed frontend origins (ใช้ทั้ง REST และ Socket.IO)
CORS_ORIGIN=http://localhost:5173

# Swagger UI / OpenAPI docs — "true" / "false" (must not be empty)
# set "false" to disable even in development
DOCS_ENABLED=true

# Rate limit — production ตรึงไว้ในโค้ด (login 10/15 นาที, register 20/ชั่วโมง)
# สองตัวนี้มีผลเฉพาะโหมด dev/test — ตั้ง RATE_LIMIT_DISABLED=true เพื่อปิด limiter ตอนพัฒนา
#LOGIN_RATE_LIMIT_MAX=10
#REGISTER_RATE_LIMIT_MAX=20
#CHANGE_PASSWORD_RATE_LIMIT_MAX=10
#RATE_LIMIT_DISABLED=true
